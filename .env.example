# Copy to .env for local development (never commit the real one).

# Supabase: Connect (top of your project) -> "Transaction pooler" connection string, with your
# database password filled in. It looks like:
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# Long random string used to sign login tokens. Generate one with:  openssl rand -hex 32
JWT_SECRET=change-me

PORT=8080

# --- Optional -------------------------------------------------------------
# Public address of the app (used in password-reset emails), e.g. https://cadence-abc123-ew.a.run.app
# APP_URL=http://localhost:8080

# Outgoing email (signup codes + password reset). Setting SMTP_URL turns email verification on.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM="Cadence <no-reply@example.com>"

# Force signup codes on without SMTP; the code is printed in the server log (for local testing).
# REQUIRE_EMAIL_VERIFICATION=true

# Database SSL is automatic for Supabase. To also verify the server's certificate, paste Supabase's
# CA certificate (Project Settings -> Database -> SSL Configuration) here:
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."
